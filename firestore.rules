rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSignature(data) {
      return data.keys().hasAll(['id', 'title', 'dataUrl', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.dataUrl is string && data.dataUrl.size() <= 950000
        && data.createdAt is number
        && (!('type' in data) || data.type in ['upload', 'draw', 'type'])
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidDocument(data) {
      return data.keys().hasAll([
        'documentId',
        'verificationToken',
        'documentName',
        'documentType',
        'documentNumber',
        'issuer',
        'signerName',
        'status',
        'createdAt'
      ])
      && data.documentId is string && data.documentId.size() <= 128
      && data.verificationToken is string && data.verificationToken.size() <= 128
      && data.documentName is string && data.documentName.size() <= 300
      && data.documentType is string && data.documentType.size() <= 100
      && data.documentNumber is string && data.documentNumber.size() <= 150
      && data.issuer is string && data.issuer.size() <= 200
      && data.signerName is string && data.signerName.size() <= 200
      && data.status in ['VALID', 'DICABUT', 'TIDAK VALID']
      && data.createdAt is number;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['id', 'verificationToken', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.verificationToken is string && data.verificationToken.size() <= 128
        && data.timestamp is number;
    }

    match /signatures/{signatureId} {
      allow read: if true;
      allow create: if isValidId(signatureId) && isValidSignature(incoming()) && incoming().id == signatureId;
      allow update: if isValidId(signatureId) && isValidSignature(incoming()) && incoming().id == signatureId;
      allow delete: if isValidId(signatureId);
    }

    match /verified_documents/{verificationToken} {
      // Public verification must allow read without authentication
      allow read: if true;
      allow create: if isValidId(verificationToken) && isValidDocument(incoming()) && incoming().verificationToken == verificationToken;
      allow update: if isValidId(verificationToken);
      allow delete: if isValidId(verificationToken);
    }

    match /verification_logs/{logId} {
      // Log creation and reading for analytics
      allow read: if true;
      allow create: if isValidId(logId) && isValidLog(incoming());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
